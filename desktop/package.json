{
  "name": "thb-directmail-desktop",
  "version": "1.0.0",
  "description": "Twin Home Buyer Direct Mail — desktop app: KPI dashboard, on-demand refresh, and the REI Blackbook → Monday → QuickBooks integration bridge.",
  "main": "main.cjs",
  "author": "Twin Home Buyer / Equity Track Inc.",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.twinhomebuyer.directmail",
    "productName": "THB Direct Mail",
    "asar": true,
    "files": ["main.cjs", "preload.cjs", "bridge.cjs", "refresh.cjs", "renderer/**/*", "assets/**/*"],
    "extraResources": [{ "from": "../thb_kpi_dashboard.html", "to": "thb_kpi_dashboard.html" }],
    "win": { "target": ["portable", "nsis"], "artifactName": "THB-DirectMail-${version}.${ext}" },
    "portable": { "artifactName": "THB-DirectMail-portable.exe" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "THB-DirectMail-Setup.exe" },
    "directories": { "output": "dist" }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
