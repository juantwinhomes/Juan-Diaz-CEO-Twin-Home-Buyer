# ==============================================================================
# Post-Property Visit Conversion System — Environment Variables
# ==============================================================================
#
# PHASE 1 (local MVP) NEEDS NONE OF THESE. Everything below is a placeholder
# for later phases. Copy this file to ".env" when you get to those phases:
#
#     cp .env.example .env
#
# Never commit your real ".env" file. It is already ignored by .gitignore.
# ------------------------------------------------------------------------------

# ---- Phase 2: Google Drive folder scanning -----------------------------------
# Path to the Google service-account JSON key file you will download from
# Google Cloud Console (APIs & Services > Credentials > Service Account).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json
# The ID of the shared Google Drive folder that holds all property-visit folders.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ---- Phase 3: Voice memo transcription ---------------------------------------
# Used to transcribe Juan's voice memo (.m4a) and extract structured facts.
# Get this from https://console.anthropic.com  (or OpenAI for Whisper).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Phase 4/7: CRM output (REI BlackBook) — NO ZAPIER NEEDED -----------------
# REI BlackBook has a NATIVE incoming webhook (Workflow Builder) that accepts
# direct POSTs to create/update a contact — no Zapier required. Create a
# workflow with a "Webhook" trigger, copy its URL, and paste it here. The
# system POSTs the flat webhook_payload straight to it.
REI_BLACKBOOK_WEBHOOK_URL=
# Optional. Only if your endpoint requires auth (native webhooks usually don't —
# the secret is baked into the unique URL). Sent as "Authorization: Bearer ...".
REI_BLACKBOOK_API_KEY=
# Master safety switch for live sending. Sends are DRY-RUN unless this is
# exactly "true" AND a webhook URL is set. Leave blank/false while testing.
SEND_LIVE=false

# ---- Phase 5: Notifications --------------------------------------------------
# Where missing-documentation alerts go. Used to route/address alert emails.
# Leave blank to use the clearly-marked placeholders in notificationService.js.
OPS_ALERT_EMAIL=
JUAN_ALERT_EMAIL=
CHERRY_ALERT_EMAIL=
# Optional Slack incoming webhook URL for alerts (alternative to email).
SLACK_WEBHOOK_URL=
