# Copy to .env for local runs. Never commit the real file.

# Default GA4 property, so callers don't have to pass propertyId every time.
# Numeric only — the "G-XXXXXXX" measurement ID is a different thing and won't work.
# Find it with the ga4_list_properties tool, or in GA4 Admin -> Property Settings.
GA4_PROPERTY_ID=

# Shared secret. Requests must send it as a bearer token or as the last path
# segment (https://host/mcp/<secret>). Leave blank ONLY for local testing —
# an open server lets anyone read your analytics.
# Generate one with: openssl rand -hex 32
MCP_SHARED_SECRET=

# Service-account key, as the entire JSON file contents on one line.
# Leave blank on Cloud Run: the attached service account is picked up
# automatically and no key material ever has to exist.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Local port. Cloud Run sets this itself.
PORT=8080
