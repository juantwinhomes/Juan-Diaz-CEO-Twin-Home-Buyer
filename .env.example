# --- Bridge ---
PORT=3000
# Shared secret appended to webhook URLs (?secret=...). Generate a long random string.
WEBHOOK_SECRET=

# --- Monday.com ---
# Personal API token: monday.com avatar menu -> Developers -> My access tokens
MONDAY_API_TOKEN=
# Property Leads board in "Equity Track Iriga – Operating System"
MONDAY_BOARD_ID=18392647845
# Group where new REI Blackbook leads land ("🚨 New Lead Alert!")
MONDAY_NEW_LEAD_GROUP_ID=topics
# Lead Stage labels that trigger the QuickBooks sync
MONDAY_CLOSED_STAGES=Acquired,Wholesale Closed

# --- QuickBooks Online ---
# Create an app at https://developer.intuit.com (Accounting scope),
# then obtain a refresh token for your company via the OAuth 2.0 playground.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
QBO_ENVIRONMENT=production
QBO_SERVICE_ITEM=Real Estate Deal
