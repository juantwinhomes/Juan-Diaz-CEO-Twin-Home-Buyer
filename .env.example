# ── Required ─────────────────────────────────────────────────────────────────
# Claude API key (https://console.anthropic.com) — used to draft replies.
ANTHROPIC_API_KEY=

# Any long random string. Protects the approval dashboard.
DASHBOARD_TOKEN=

# ── REI BlackBook (sending replies back) ─────────────────────────────────────
# URL of the REI BlackBook webform that triggers your "Send AI Reply" workflow.
# See README.md "REI BlackBook setup" for how to create it. Until this is set,
# drafts can be reviewed on the dashboard but not sent automatically.
REIBB_SEND_WEBFORM_URL=

# Field names of that webform (defaults shown).
#REIBB_FIELD_PHONE=phone
#REIBB_FIELD_FIRST_NAME=first_name
#REIBB_FIELD_LAST_NAME=last_name
#REIBB_FIELD_REPLY=ai_reply

# ── Inbound webhook ──────────────────────────────────────────────────────────
# Optional shared secret; if set, REI BlackBook must call
# /webhook/inbound-text?secret=<value>
WEBHOOK_SECRET=

# Field names in the inbound webhook payload (defaults shown).
#WEBHOOK_FIELD_PHONE=phone
#WEBHOOK_FIELD_MESSAGE=message
#WEBHOOK_FIELD_FIRST_NAME=first_name
#WEBHOOK_FIELD_LAST_NAME=last_name

# ── Behavior ─────────────────────────────────────────────────────────────────
# approve (default): every draft waits for your one-tap approval on the dashboard.
# auto: replies send automatically (except fallbacks and during quiet hours).
REPLY_MODE=approve

# Claude model used for drafting.
#CLAUDE_MODEL=claude-sonnet-5

# Quiet hours — auto-send is suppressed between these local hours (24h clock).
#QUIET_HOURS_TZ=America/Chicago
#QUIET_HOURS_START=21
#QUIET_HOURS_END=8

# ── Notifications (optional) ─────────────────────────────────────────────────
# JSON POST fired when a draft needs approval. Point at a Zapier/Make hook that
# texts or emails you, or a Slack incoming webhook.
NOTIFY_WEBHOOK_URL=
# Public URL of this service, used to build the approval link in notifications.
PUBLIC_BASE_URL=

#PORT=3000
