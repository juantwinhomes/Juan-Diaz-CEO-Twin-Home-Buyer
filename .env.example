# Copy this file to .env and fill in your keys.

# RentCast — https://app.rentcast.io/app/api
RENTCAST_API_KEY=

# ATTOM (optional, phase 2) — https://api.developer.attomdata.com/
ATTOM_API_KEY=

# GoHighLevel inbound webhook URL (optional). When set, properties at or above
# the CRM threshold are POSTed here as JSON.
GHL_WEBHOOK_URL=
